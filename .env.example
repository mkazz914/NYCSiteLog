# Neon (or any Postgres) connection string
DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require
# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Google sign-in (optional if Microsoft is set up). From Google Cloud Console > APIs & Services > Credentials (OAuth client, Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public URL of the site, no trailing slash. Redirect URI to register with Google: <PUBLIC_URL>/api/callback
PUBLIC_URL=http://localhost:5000
# Comma-separated Google accounts allowed to sign in (empty = nobody)
ALLOWED_EMAILS=you@gmail.com,teammate@gmail.com
# Optional: let everyone on a Google Workspace domain sign in (comma-separated)
ALLOWED_DOMAINS=
# Optional: set to "off" to switch off the Content-Security-Policy header if a page breaks
CSP=

# Microsoft sign-in (optional). From Microsoft Entra > App registrations.
# Redirect URI to register (Web platform): <PUBLIC_URL>/api/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
